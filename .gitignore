data/fab_thickness_profile_*.csv
data/raw/

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local run artefacts
outputs/*.log
*.log

# NOTE: models/surrogate_bundle.joblib IS committed on purpose so teammates can
